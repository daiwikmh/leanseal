<section class="tab-panel active" data-panel="overview" aria-label="Run">
          <section class="trade-grid" aria-label="Run">
            <article class="surface run-surface">
              <div class="order-ticket" id="order-ticket" hidden>
                <span class="eyebrow">NEW SEALED ORDER · LIVE DEVNET</span>
                <div class="order-row"><span>Side</span><div class="seg" id="order-side"><button type="button" class="on" data-side="buy">Buy tUSD</button><button type="button" data-side="sell">Sell tUSD</button></div></div>
                <div class="order-row"><span>Amount</span><div class="order-amount"><input id="order-amount" type="number" inputmode="decimal" min="0" step="any" value="0.0005" /><em id="order-unit">ETH</em><button type="button" class="quiet-button" id="order-max">Max</button></div></div>
                <div class="order-row"><span>Limit</span><div class="seg" id="order-slip"><button type="button" data-bps="50">0.5%</button><button type="button" data-bps="100">1%</button><button type="button" class="on" data-bps="300">3%</button></div></div>
                <p class="order-estimate" id="order-estimate">Unlock your passkey and create your wallet to trade.</p>
                <div class="vault-box">
                  <dl id="vault-balances"><dt>Wallet</dt><dd>—</dd><dt>Pool vault</dt><dd>—</dd></dl>
                  <div class="vault-actions"><button type="button" class="quiet-button outline" id="faucet-btn">Get test funds</button><button type="button" class="quiet-button outline" id="withdraw-btn">Withdraw vault</button></div>
                </div>
                <button type="button" class="primary-button run-button" id="order-submit">Submit sealed order <span aria-hidden="true">↗</span></button>
              </div>
              <div class="scenario-block" id="scenario-block">
              <label class="eyebrow" for="scenario">WHAT DO YOU WANT TO SEE?</label>
              <select id="scenario" class="scenario-select"></select>
              <p class="scenario-text" id="scenario-text"></p>
              <dl class="scenario-facts" id="scenario-facts"></dl>
              <label class="transfer-to" id="transfer-to-row" hidden><span>To</span><input id="transfer-to" type="text" spellcheck="false" placeholder="0x… any address (default: our demo recipient)" /></label>
              <ul class="problems" id="flag-problems" hidden></ul>
              <button type="button" class="quiet-button advanced-open" id="advanced-open">Advanced settings…</button>
              <dialog class="settings-dialog" id="advanced-dialog" aria-labelledby="advanced-title">
                <div class="dialog-head"><h3 id="advanced-title">Advanced settings</h3><button type="button" class="quiet-button" id="advanced-close" aria-label="Close">✕</button></div>
                <p class="dialog-note">Greyed-out options can't work with the rest. Hover one to see why.</p>
                <div class="quick-flags" id="quick-flags"></div>
                <div class="dialog-foot"><button type="button" class="quiet-button outline" id="advanced-reset">Reset</button><button type="button" class="primary-button" id="advanced-done">Done</button></div>
              </dialog>
              <button id="run-main" class="primary-button run-button">Run <span aria-hidden="true">↗</span></button>
              </div>
            </article>
            <article class="surface chart-surface">
              <div class="live-head"><span class="eyebrow">WHAT HAPPENS</span><span class="run-meta" id="run-meta"></span><span class="queue-count" id="run-state">idle</span></div>
              <div class="result-strip">
                <div><span>QUOTED</span><strong data-r="quote">—</strong></div>
                <div><span>RECEIVED</span><strong data-r="received">—</strong></div>
                <div><span>LOSS</span><strong data-r="loss">—</strong></div>
                <div><span>GAS</span><strong data-r="gas">—</strong></div>
              </div>
              <div class="seg live-tabs" id="live-tabs" role="tablist"><button type="button" class="on" data-live="log" role="tab" aria-selected="true">Log</button><button type="button" data-live="result" role="tab" aria-selected="false">Result</button><button type="button" data-live="txs" role="tab" aria-selected="false">Transactions</button></div>
              <div class="live-body">
                <pre class="log" id="log" data-live-panel="log" aria-live="polite"></pre>
                <div class="live-pane" data-live-panel="result" hidden><div class="verdict" id="verdict" hidden></div><p class="live-empty" id="verdict-empty">No result yet.</p></div>
                <div class="live-pane tx-list" id="tx-list" data-live-panel="txs" hidden></div>
              </div>
            </article>
          </section>
          <div class="overview-grid">
            <article class="surface activity-surface"><div class="surface-heading"><div><span class="eyebrow">HISTORY</span><h3>Recent runs</h3></div><button class="quiet-button" data-refresh>Refresh ↻</button></div><div id="run-list" class="activity-list"><div class="loading-row">Loading…</div></div></article>
            <article class="surface readiness-surface"><span class="eyebrow">SERVICES</span><h3>What is running</h3><div id="service-lines"></div></article>
          </div>
        </section>
