---
import LaunchLink from "./LaunchLink.astro";
---

<section class="closing" id="waitlist" aria-labelledby="closing-title">
  <div class="closing-content">
    <h2 id="closing-title">Every chain.<br />One account.</h2>
    <p class="closing-lede">Open a USDC account on NEAR, get paid from any chain and pay anyone on any chain today. All it takes is a passkey.</p>
    <LaunchLink class="light-button">Start with a passkey <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"></path></svg></LaunchLink>
  </div>
</section>
