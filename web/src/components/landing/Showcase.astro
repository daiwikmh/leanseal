---
const cards = [
  { tag: "01", title: "Invoices and links", text: "Send an invoice or share a reusable payment link. Customers pay with USDC, ETH, SOL, BTC or USDT on their own chain; you receive exact USDC." },
  { tag: "02", title: "Payouts and payroll", text: "Pay one contractor or twenty in one passkey signature. Each person receives the token and chain they choose, delivered by NEAR Intents." },
  { tag: "03", title: "Checkout API and webhooks", text: "Create checkouts and invoices from your backend, then get HMAC-signed webhooks on paid, refunded and delivered. Keys are shown once and stored hashed." },
  { tag: "04", title: "Books and proof", text: "Every status links to both chains. Export invoices and payroll as CSVs your accountant opens without a single question." },
] as const;
---

<section class="applications section-frame" id="assets" aria-labelledby="invoice-title">
  <div class="section-heading">
    <h2 id="invoice-title">Payments for customers<br />who don't care about crypto.</h2>
    <p>They pay and get paid with what they already hold. You run everything from one USDC account on NEAR and never buy NEAR for gas.</p>
  </div>

  <div class="bot-status" data-bot-status>
    <span class="bot-dot" data-bot-dot></span>
    <b data-bot-line>Checking opencash…</b>
    <small data-bot-sub>NEAR mainnet</small>
  </div>

  <div class="bot-grid">
    {cards.map((card) => (
      <article class="bot-card">
        <span>{card.tag}</span>
        <h3>{card.title}</h3>
        <p>{card.text}</p>
      </article>
    ))}
  </div>
  <p class="bot-cta"><a class="text-link" href="/app">Open an account <span aria-hidden="true">↗</span></a></p>
</section>

<script>
  const line = document.querySelector<HTMLElement>("[data-bot-line]");
  const sub = document.querySelector<HTMLElement>("[data-bot-sub]");
  const dot = document.querySelector<HTMLElement>("[data-bot-dot]");

  async function load() {
    try {
      const health = (await fetch("/api/health").then((r) => r.json())) as { ok: boolean; contract: string; parent: string };
      if (line) line.textContent = health.ok ? "opencash is live" : "opencash is paused";
      if (sub) sub.textContent = `NEAR mainnet · registry ${health.contract}`;
      if (dot) dot.dataset.on = health.ok ? "1" : "0";
    } catch {
      if (line) line.textContent = "Status unavailable";
      if (dot) dot.dataset.on = "0";
    }
  }
  void load();
</script>

<style>
  .bot-status { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 32px; padding: 16px 20px; border-radius: 999px; background: rgba(255, 255, 255, 0.06); }
  .bot-dot { width: 10px; height: 10px; border-radius: 50%; background: #8a928f; }
  .bot-dot[data-on="1"] { background: #3ecf8e; box-shadow: 0 0 0 4px rgba(62, 207, 142, 0.2); }
  .bot-dot[data-on="0"] { background: #ef5b5b; }
  .bot-status b { font-weight: 600; }
  .bot-status small { opacity: 0.6; }
  .bot-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-top: 24px; }
  .bot-card { padding: 24px; border-radius: 24px; background: #c4f299; color: #10210a; display: flex; flex-direction: column; gap: 8px; }
  .bot-card:nth-child(2) { background: #f2d16b; }
  .bot-card:nth-child(3) { background: #f2b98b; }
  .bot-card:nth-child(4) { background: #cfe6ff; }
  .bot-card span { font-size: 12px; letter-spacing: 0.14em; opacity: 0.6; }
  .bot-card h3 { margin: 0; font-size: 22px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; }
  .bot-card p { margin: 0; font-size: 15px; line-height: 1.5; }
  .bot-cta { margin-top: 24px; }
</style>
