---
import App from "../layouts/App.astro";
import Mark from "../components/Mark.astro";
---

<App title="Connect chat · opencash">
  <main class="dash pay">
    <div class="pay__card">
      <div class="pay__head">
        <a class="wordmark" href="/"><Mark />open<span>cash</span></a>
        <span class="tag">Connect a chat</span>
      </div>
      <div class="card">
        <b class="company__name">Connect this chat to opencash</b>
        <p class="panel__lede">Sign in with your passkey to prove which account the chat should control. The chat can see your balance, request payments and prepare payouts; every payout is still signed by you, here.</p>
        <div class="warn-box" data-link-who style="margin-top:var(--sp-md)">Checking this link…</div>
        <label class="consent"><input type="checkbox" data-link-confirm /> <span>I just asked the bot for this link myself, from the chat named above. (If someone sent you this link, close this page.)</span></label>
        <div class="btn-row" style="margin-top:var(--sp-md)">
          <button type="button" class="btn btn--primary" data-link-passkey disabled>Sign in with passkey</button>
          {import.meta.env.DEV && <button type="button" class="btn" data-link-dev disabled>Dev mode · skip passkey</button>}
        </div>
        <p class="status-line" data-link-status role="status"></p>
      </div>
    </div>
  </main>
  <script>
    import "../scripts/chatlink/index";
  </script>
</App>
