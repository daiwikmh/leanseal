---
import App from "../layouts/App.astro";
import Mark from "../components/Mark.astro";
---

<App title="Pay invoice · opencash">
  <main class="dash pay">
    <div class="pay__card">
      <div class="pay__head">
        <a class="wordmark" href="/"><Mark />open<span>cash</span></a>
        <span class="tag" data-pay-status>Loading…</span>
      </div>

      <div class="pay__face">
        <span class="card__label" data-pay-from>—</span>
        <span class="pay__amount" data-pay-amount>—</span>
        <span data-pay-due>—</span>
        <div data-pay-items></div>
      </div>

      <div class="card" data-pay-near hidden>
        <span class="panel__label">Have USDC on NEAR?</span>
        <p class="panel__lede">Pay straight from your NEAR wallet: one transaction, settled on chain instantly, no conversion fee.</p>
        <button type="button" class="btn btn--primary" data-pay-near-go style="margin-top:var(--sp-sm)">Pay with a NEAR wallet</button>
      </div>
      <div class="card" data-pay-form hidden>
        <span class="panel__label">Or pay with what you hold on another chain</span>
        <div class="field-row">
          <label class="field"><span>Token and chain</span><select data-pay-asset></select></label>
          <label class="field"><span>Refund address on that chain</span><input data-pay-refund placeholder="If anything fails, funds return here" /></label>
        </div>
        <p class="quote-line" data-pay-quote></p>
        <button type="button" class="btn btn--primary" data-pay-go disabled>Get deposit address</button>
      </div>

      <div class="card pay__deposit" data-pay-deposit hidden>
        <span class="panel__label" data-pay-send></span>
        <div class="qr" data-pay-qr></div>
        <code class="mono" data-pay-address></code>
        <button type="button" class="btn" data-pay-copy>Copy address</button>
        <p class="status-line" data-pay-progress role="status"></p>
      </div>

      <div class="card" data-pay-receipt hidden>
        <span class="panel__label">Receipt</span>
        <div data-pay-receipt-rows></div>
      </div>

      <p class="pay__trust">Settles as USDC to the business's NEAR account via NEAR Intents. You never need NEAR or a NEAR wallet.</p>
    </div>
  </main>
  <script>
    import "../scripts/pay/index";
  </script>
</App>
