+describe("validateStructuralRules: BUDGET-010 staked budget", () => {
+  const pqFrame = (execution: bigint): Frame => ({
+    ...verifyFrame(APPROVE_SCOPE.EXECUTION_AND_PAYMENT),
+    limits: { execution, state: 0n },
+  });
+
+  it("rejects a 400k prefix under the default budget", () => {
+    const frames = [pqFrame(400_000n)];
+    const prefix = recognizeValidationPrefix(frames, SENDER)!;
+    const result = validateStructuralRules(baseTx(frames), prefix);
+    expect(result.valid).toBe(false);
+  });
+
+  it("accepts a 400k prefix under the staked budget", () => {
+    const frames = [pqFrame(400_000n)];
+    const prefix = recognizeValidationPrefix(frames, SENDER)!;
+    const result = validateStructuralRules(baseTx(frames), prefix, MAX_VERIFY_GAS_STAKED_ENTITY);
+    expect(result.valid).toBe(true);
+  });
+
+  it("rejects a prefix over the staked budget", () => {
+    const frames = [pqFrame(MAX_VERIFY_GAS_STAKED_ENTITY + 1n)];
+    const prefix = recognizeValidationPrefix(frames, SENDER)!;
+    const result = validateStructuralRules(baseTx(frames), prefix, MAX_VERIFY_GAS_STAKED_ENTITY);
+    expect(result.valid).toBe(false);
+  });
