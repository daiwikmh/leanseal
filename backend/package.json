{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "deploy:registry": "tsx --env-file-if-exists=.env scripts/deploy-registry.ts",
    "check": "tsx src/relayer.check.ts && tsx src/intents.check.ts",
    "db:migrate": "tsx --env-file-if-exists=.env db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastnear/x402": "2.5.0",
    "@xmtp/agent-sdk": "2.3.1",
    "borsh": "^2.0.0",
    "fastify": "^5.2.1",
    "near-api-js": "7.5.3",
    "pg": "^8.13.1",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@pingpay/agentpay-middleware": "0.2.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "express": "5.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
